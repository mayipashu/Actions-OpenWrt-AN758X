From: mayipashu <mayipashu@users.noreply.github.com>
Date: Wed, 19 Nov 2026 12:00:00 +0800
Subject: [PATCH] mt7915: add NPU receive offload for legacy MT7916 firmware

Bring up hardware packet offload on EN7581 boards with PCIe MT7915/MT7916
radios, using the NPU receive transport from Sirherobrine23/mt76
(branch npu_en7523) with three adaptations for the EN7581 PCIe layout:

  - EN7581 maps its PCIe controllers at 0x1fc0/0x1fc2 000 instead of
    0x1fa9{1,2}000, so both base addresses are accepted and the P0/P1
    port mapping covers the new pairs;
  - the chip-model enum (AIROHA_NPU_WLAN_MT7915/_DBDC/_MT7916) is defined
    locally until the ABI lands in the airoha headers, with a
    mt7915_npu_model module parameter to override the value at runtime;
  - only the NPU-relevant hunks are ported (dma/mac/pci/mt7915.h),
    main.c is left untouched so the fork's newer mac80211 API is not
    required.

When the NPU transport is active it owns the Wi-Fi data RX rings: their
completion interrupts are masked and the RX queues are allocated through
mt7915_npu_rx_ring() so descriptors live in NPU memory. The PPE receives
the reordered frames directly, bypassing the host CPU path.

Signed-off-by: mayipashu <mayipashu@users.noreply.github.com>
---
--- a/mt7915/dma.c
+++ b/mt7915/dma.c
@@ -257,6 +257,13 @@
 	struct mt76_dev *mdev = &dev->mt76;
 	u32 hif1_ofs = 0;
 	u32 irq_mask;
+	int err;
+
+	if (!reset) {
+		err = mt7915_npu_start(dev);
+		if (err)
+			return err;
+	}
 
 	if (dev->hif2)
 		hif1_ofs = MT_WFDMA0_PCIE1(0) - MT_WFDMA0(0);
@@ -323,6 +330,11 @@
 		mtk_wed_device_start(&dev->mt76.mmio.wed, wed_irq_mask);
 	}
 
+	/* The NPU owns the Wi-Fi data RX rings once active. */
+	if (mt7915_npu_active(dev) && !reset)
+		irq_mask &= ~(MT_INT_RX(MT_RXQ_MAIN) |
+			      MT_INT_RX(MT_RXQ_BAND1));
+
 	irq_mask = reset ? MT_INT_MCU_CMD : irq_mask;
 
 	mt7915_irq_enable(dev, irq_mask);
@@ -421,6 +433,10 @@
 
 	mt7915_dma_disable(dev, true);
 
+	ret = mt7915_npu_init(dev);
+	if (ret)
+		return ret;
+
 	if (mtk_wed_device_active(&mdev->mmio.wed)) {
 		if (!is_mt798x(mdev)) {
 			u8 wed_control_rx1 = is_mt7915(mdev) ? 1 : 2;
@@ -516,7 +532,13 @@
 			mdev->q_rx[MT_RXQ_MAIN].wed = &mdev->mmio.wed;
 		}
 
-		ret = mt76_queue_alloc(dev, &dev->mt76.q_rx[MT_RXQ_MAIN],
+		if (mt7915_npu_active(dev))
+			ret = mt7915_npu_rx_ring(dev, MT_RXQ_MAIN,
+						MT7915_RX_RING_SIZE,
+						MT_RXQ_RING_BASE(MT_RXQ_MAIN) +
+						MT_RXQ_ID(MT_RXQ_MAIN) * 0x10);
+		else
+			ret = mt76_queue_alloc(dev, &dev->mt76.q_rx[MT_RXQ_MAIN],
 				       MT_RXQ_ID(MT_RXQ_MAIN),
 				       MT7915_RX_RING_SIZE,
 				       MT_RX_BUF_SIZE,
@@ -556,7 +578,13 @@
 		}
 
 		/* rx data queue for band1 */
-		ret = mt76_queue_alloc(dev, &dev->mt76.q_rx[MT_RXQ_BAND1],
+		if (mt7915_npu_active(dev))
+			ret = mt7915_npu_rx_ring(dev, MT_RXQ_BAND1,
+						MT7915_RX_RING_SIZE,
+						MT_RXQ_RING_BASE(MT_RXQ_BAND1) +
+						MT_RXQ_ID(MT_RXQ_BAND1) * 0x10);
+		else
+			ret = mt76_queue_alloc(dev, &dev->mt76.q_rx[MT_RXQ_BAND1],
 				       MT_RXQ_ID(MT_RXQ_BAND1),
 				       MT7915_RX_RING_SIZE,
 				       MT_RX_BUF_SIZE,
